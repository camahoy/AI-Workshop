# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# Public (bundled into the app) — Supabase project URL + anon key. Leave blank to run local-only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: where the app calls the chat API. Leave blank when the app and /api are on the same Vercel deploy.
EXPO_PUBLIC_API_BASE=

# Server-only (Vercel function) — never prefix with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=
# Model for the onboarding chat. The brief specifies claude-sonnet-4-6.
ORBOU_MODEL=claude-sonnet-4-6
