# Paste into this app's Settings → Secrets on Streamlit Community Cloud
# (or copy to .streamlit/secrets.toml for local runs; that file is gitignored).

# Required. Unlocks the presenter view (?board=a&view=present).
PRESENTER_PASSCODE = "choose-a-passcode"

# Optional. The app's public URL, used for the QR codes and short links.
# If unset, the presenter's own browser address is used.
APP_BASE_URL = "https://your-boards-app.streamlit.app"

# Optional, OFF unless all four are set AND the presenter switches
# "AI themes" on in Settings. Only use a model Ipsos has approved for
# internal data (e.g. the Ipsos Azure OpenAI tenant).
# AI_SUMMARY_PROVIDER = "azure_openai"
# AZURE_OPENAI_ENDPOINT = "https://<resource>.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT = "<deployment-name>"
# AZURE_OPENAI_API_KEY = "<key>"
# AZURE_OPENAI_API_VERSION = "2024-10-21"
