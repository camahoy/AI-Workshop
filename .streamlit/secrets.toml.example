# Copy this file to .streamlit/secrets.toml for local development.
# .streamlit/secrets.toml is gitignored — never commit real keys.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# REQUIRED on Streamlit Community Cloud: where every board post and survey
# response is stored. The app's local disk is wiped on restart, so without
# this, data is NOT durable. Use a hosted Postgres connection string, e.g.
# Supabase → Project Settings → Database → Connection string → "Transaction
# pooler" (port 6543), with your database password filled in.
DATABASE_URL = "postgresql://postgres.xxxxxxxx:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Required for any facilitator control (Export, Reset board, Summary,
# session settings). Entered on the app's base URL (no ?session=). If this
# is not set, no one can open facilitator controls.
FACILITATOR_PASSWORD = "choose-a-passphrase"

# Required to open the N = Everyone Results page (pages/2_Survey_Results.py).
# This is not the survey link itself — respondents never see or need this.
# Without it set, the results page stays locked.
SURVEY_RESULTS_PASSWORD = "choose-a-different-password"

# Optional: prefills the "Deployed app URL" field in the facilitator
# sidebar (used to build the QR code / join link). You can also just
# paste it in manually each session.
APP_BASE_URL = "https://your-app-name.streamlit.app"

# Optional: override the default model used for the closing summary.
# ANTHROPIC_MODEL = "claude-sonnet-5"

# Strongly recommended: every N = Everyone submission is also POSTed here
# as a redundant backup, independent of this app's local disk (which is
# NOT guaranteed to survive a reboot/sleep/redeploy on Streamlit Community
# Cloud). Set up a Google Apps Script Web App (see README) and paste its
# /exec URL here. Without this set, submissions still save locally, they
# just have no off-platform backup.
# SHEETS_WEBHOOK_URL = "https://script.google.com/macros/s/XXXXXXXX/exec"
